.DS_Store
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.swp
*.tmp
DerivedData/
build/
.build/
release/

# Machine-specific Codex configuration.
/.codex/

# Python bytecode from local checks and asset scripts.
__pycache__/
*.pyc

# Local experiments and editable promo projects.
/experiments/
/promo-remotion/
/promo-storyboard-remotion/
/promo-update-remotion/

# Local diagnostics, environment values and signing credentials.
*.log
*.xcresult/
.env
.env.*
!.env.example
*.p12
*.pfx
*.key

# Recordings, editable projects, screenshots and other media are private by default.
# Publish individual website assets only after their contents and source are reviewed.
/recordings/
/captures/
/test-results/
*.mov
*.mp4
*.m4v
*.webm
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.aiff
*.png
*.jpg
*.jpeg
*.heic
*.webp
*.gif
*.zip
*.dmg
*.pkg
*.screentake
*.screenize
*.mouse.json

# App resources are part of the open-source build.
!/Screen/Assets.xcassets/**/*.png
!/Screen/Assets.xcassets/**/*.jpg
!/Screen/Assets.xcassets/**/*.jpeg
!/Screen/Resources/**/*.png
!/Screen/Resources/**/*.jpg
!/Screen/Resources/**/*.jpeg

# Ignore rules do not remove tracked files or media in earlier commits/tags.

# Skill pack (copilot/claude agent files)
.github/agents/
.github/copilot-instructions.md
skills/
!/.agents/skills/
!/.agents/skills/**
.claude/
CLAUDE.md
test_audio.swift
test_mux.swift

# Private blog content must remain local-only.
**/*[Bb][Ll][Oo][Gg]*
/Saved Projects/
